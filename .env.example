# toggle display (0 = off, 1 = on)
CHOCO_DISPLAY=1

# chocoweb server
CHOCO_WEB_HOST=127.0.0.1
CHOCO_WEB_PORT=8000
# set both to enable HTTPS (recommended for LAN access — required for WebRTC on Safari/iOS)
CHOCO_WEB_SSL_CERT=
CHOCO_WEB_SSL_KEY=

# log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
PIPECAT_LOG_LEVEL=INFO
CHOCO_LOG_LEVEL=INFO

# Provider API keys
OPENAI_API_KEY=
GOOGLE_API_KEY=
ULTRAVOX_API_KEY=
